# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Application Mode: true uses mock data for testing/demo without API quota usage
DEMO_MODE=true

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./career_intelligence.db

# Security & Constraints
MAX_RESUME_SIZE_MB=10
LLM_TIMEOUT=30
LOG_LEVEL=INFO

# Market Data Provider (mock | serper | http)
MARKET_PROVIDER=mock
